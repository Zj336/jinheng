# 复制成 .env 再填值。`.env` 已在 .gitignore 里，**不会**被提交。
# 全部可选：不填任何东西，`python selfcheck.py` 也能跑通全流程（mock 模式）。

# ---- 接真模型（默认 mock，不联网）----
# JH_LLM_MODE=openai
# JH_LLM_BASE_URL=https://api.openai.com/v1
# JH_LLM_API_KEY=
# JH_LLM_MODEL=gpt-4o-mini
# JH_LLM_TIMEOUT=30

# ---- 身份 ----
# 留空则在 data/.auth_secret 生成一次并复用（生产须走 KMS / 环境变量）
# JH_AUTH_SECRET=
# JH_TOKEN_TTL=7200

# ---- 限额（单位：分）----
# 单日累计超了直接拒绝，强验证不能覆盖
# JH_DAILY_LIMIT_CENTS=100000
# JH_MONTHLY_LIMIT_CENTS=2000000
# JH_CONTACT_DAILY_LIMIT_CENTS=100000
# 单笔达到这个数升级为强验证
# JH_CONFIRM_LIMIT_CENTS=50000

# ---- 熔断 / 沙箱 ----
# JH_CIRCUIT_FAILS=3
# JH_CIRCUIT_INJECTS=4
# JH_SANDBOX_TIMEOUT=5
# JH_SANDBOX_MEM_MB=256
